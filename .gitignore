# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
.env
*.env
!.env.example

# Sensitive Data & Personal Configs (CRITICAL: NEVER COMMIT KEYS OR ACCOUNTS)
accounts.json
history.json
settings.json
cookies.txt
*key*.json
*secret*.json
*credential*.json
*token*.json
*.session
*.session-journal
/data/*.json
/data/*.txt
!/data/*.example.json
!/data/settings.example.json
!/data/accounts.example.json

# Runtime Storage, Videos & Logs
/storage/inputs/*
!/storage/inputs/.gitkeep
/storage/outputs/*
!/storage/outputs/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/input_sources/*
!/input_sources/.gitkeep
/output_product/*
!/output_product/.gitkeep
/Tiktok_Builder_Output/*
!/Tiktok_Builder_Output/.gitkeep
/video/*
!/video/.gitkeep

# Media files
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.part
*.ts
*.flv
*.m4a
*.mp3
*.wav

# Large Binaries (Auto-downloaded via Install_Dependencies.bat)
/bin/*
!/bin/.gitkeep
*.exe
*.zip
*.tar.gz

# Local OS & Windows Shortcut Files
*.lnk
.DS_Store
Thumbs.db
Desktop.ini
*.log

# Scratch & Temporary test files
test_*
scratch/
scratch_*.py
temp_*
mw2_frame.png


